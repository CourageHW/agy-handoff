{
  "name": "agy-handoff",
  "version": "0.2.0",
  "description": "Antigravity plugin to hand off code reviews, debugging, and second-opinion checks to local OpenAI Codex and Anthropic Claude Code CLIs.",
  "type": "module",
  "license": "MIT",
  "author": "yonggi.hw",
  "repository": {
    "type": "git",
    "url": "https://github.com/CourageHW/agy-handoff.git"
  },
  "homepage": "https://github.com/CourageHW/agy-handoff#readme",
  "bugs": {
    "url": "https://github.com/CourageHW/agy-handoff/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "agy-handoff": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "agents/",
    "skills/",
    "rules/",
    "assets/",
    "plugin.json",
    "mcp_config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:live": "node ./scripts/e2e-live.mjs",
    "mcp": "node ./src/mcp-server.mjs",
    "doctor": "node ./src/cli.mjs doctor"
  },
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "agy",
    "mcp",
    "codex",
    "claude-code",
    "code-review",
    "handoff"
  ]
}
